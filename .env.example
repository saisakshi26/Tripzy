# ───────────────────────────────────────────────────────────────
# TRIPZY environment variables
# Copy this file to .env.local and fill in what you have.
# Every key is OPTIONAL: without keys Tripzy runs in clearly-labelled DEMO MODE.
# Keys are read ONLY by server-side API routes and are never sent to the browser.
# ───────────────────────────────────────────────────────────────

# Google Gemini — personalises/enriches itineraries and understands assistant requests
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Places API (New) — live hotels / restaurants with verified ratings & photos
# Enable "Places API (New)" in Google Cloud Console and create an API key
GOOGLE_PLACES_API_KEY=

# Unsplash — optional, fetches licensed destination photos when a curated photo fails to load
# Get a key: https://unsplash.com/developers  (use the "Access Key")
UNSPLASH_ACCESS_KEY=
